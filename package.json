{
  "name": "tarkov-hud-pt",
  "version": "1.3.0",
  "description": "Tarkov HUD PT - GPS por screenshots nativas e mapas reais",
  "main": "src/main.js",
  "author": "Tarkov HUD PT",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win nsis"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "electron": "^37.10.3",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "pt.tarkovhud.app",
    "productName": "Tarkov HUD PT",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false
    }
  }
}
